#!/bin/sh
# OpenClaw CLI — managed by StoryClaw (must match electron-builder productName / MacOS binary).
# Do not edit manually unless packaging names change.

# Resolve the real path of this script (follow symlinks)
SCRIPT="$0"
while [ -L "$SCRIPT" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT")" && pwd)"
  SCRIPT="$(readlink "$SCRIPT")"
  [ "${SCRIPT#/}" = "$SCRIPT" ] && SCRIPT="$SCRIPT_DIR/$SCRIPT"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT")" && pwd)"

if [ "$(uname)" = "Darwin" ]; then
  # macOS: <App>.app/Contents/Resources/cli/openclaw
  # SCRIPT_DIR = .../Contents/Resources/cli
  CONTENTS_DIR="$(dirname "$(dirname "$SCRIPT_DIR")")"
  ELECTRON="$CONTENTS_DIR/MacOS/StoryClaw"
  CLI="$CONTENTS_DIR/Resources/openclaw/openclaw.mjs"
else
  # Linux: e.g. /opt/storyclaw/resources/cli/openclaw (install dir = app root)
  # SCRIPT_DIR = .../resources/cli
  INSTALL_DIR="$(dirname "$(dirname "$SCRIPT_DIR")")"
  ELECTRON="$INSTALL_DIR/storyclaw"
  CLI="$INSTALL_DIR/resources/openclaw/openclaw.mjs"
fi

if [ ! -f "$ELECTRON" ]; then
  echo "Error: StoryClaw executable not found at $ELECTRON" >&2
  echo "Please reinstall StoryClaw or remove this symlink and use npm openclaw: $0" >&2
  exit 1
fi

case "$1" in
  update)
    echo "openclaw is managed by StoryClaw (bundled version)."
    echo ""
    echo "To update openclaw, update StoryClaw:"
    echo "  Open StoryClaw > Settings > Check for Updates"
    echo ""
    ELECTRON_RUN_AS_NODE=1 "$ELECTRON" "$CLI" --version 2>/dev/null || true
    exit 0
    ;;
esac

export OPENCLAW_EMBEDDED_IN="StoryClaw"
ELECTRON_RUN_AS_NODE=1 exec "$ELECTRON" "$CLI" "$@"
